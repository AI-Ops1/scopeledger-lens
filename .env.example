# Keep this file server-side. Copy to .env and supply your own key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
HOST=127.0.0.1
PORT=4173
# Required when HOST is not a loopback address. Share only with invited testers.
APP_ACCESS_TOKEN=
# Maximum provider calls per UTC day, including failed calls (single server process).
MAX_DAILY_CALLS=30
# Optional real booking/contact URL for your free exposure review.
REVIEW_URL=
